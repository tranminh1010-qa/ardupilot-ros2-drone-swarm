# Core DDS Configuration (UDP-based)
DDS_ENABLE = 1              # Enable DDS over UDP
DDS_UDP_PORT = 2019         # Base port (will be offset per instance)

# Serial Protocol Assignment
SERIAL0_PROTOCOL = 2        # MAVLink2 for QGroundControl
SERIAL1_PROTOCOL = 2        # MAVLink2 telemetry (not DDS)
SERIAL1_BAUD = 57          # 57600 baud for telemetry

# System Identification
SYSID_THISMAV = 1          # Unique per drone (1-4)
SYSID_MYGCS = 255          # Ground Control System ID

# Simulation Performance
SIM_SPEEDUP = 1            # Real-time simulation