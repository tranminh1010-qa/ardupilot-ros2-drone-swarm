<?xml version='1.0'?>
<sdf version="1.9">
  <!-- Spraying-drone extension of base_drone_2 (instance 2, FDM port 9022):
       wraps the plain drone model and adds a REPRESENTATIVE-SCALE agricultural
       sprayer body (DJI Agras T25-class, ~3x the iris airframe): large hull,
       four extended arms with rotor discs, 20 L-class tank, 2.4 m spray boom
       with 6 nozzles, and particle-emitter spray plumes.

       All added geometry is visual-only with negligible mass, so the tuned
       iris flight dynamics are unchanged. AC_Sprayer firmware config lives in
       src/swarm_control/parameters/sprayer.parm (DRONE_ROLE=sprayer).

       Plume toggle topic: /sprayer/2/spray_cmd (driven by
       src/scripts/spray_visualizer.py from the real pump servo output). -->
  <model name="drone3_sprayer">
    <include>
      <uri>model://base_drone_2</uri>
      <name>drone</name>
    </include>

    <!-- Large sprayer hull + arms + rotor discs (visual shell) -->
    <link name="hull_link">
      <pose degrees="true">0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="hull">
        <geometry><box><size>0.9 0.5 0.25</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.15 1</ambient>
          <diffuse>0.15 0.35 0.15 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="arm_fl">
        <pose degrees="true">0.55 0.55 0.05 0 0 45</pose>
        <geometry><box><size>1.1 0.08 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_fr">
        <pose degrees="true">0.55 -0.55 0.05 0 0 -45</pose>
        <geometry><box><size>1.1 0.08 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_rl">
        <pose degrees="true">-0.55 0.55 0.05 0 0 -45</pose>
        <geometry><box><size>1.1 0.08 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_rr">
        <pose degrees="true">-0.55 -0.55 0.05 0 0 45</pose>
        <geometry><box><size>1.1 0.08 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="rotor_disc_fl">
        <pose>0.95 0.95 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.4</radius><length>0.015</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 0.6</ambient><diffuse>0.25 0.25 0.25 0.6</diffuse></material>
      </visual>
      <visual name="rotor_disc_fr">
        <pose>0.95 -0.95 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.4</radius><length>0.015</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 0.6</ambient><diffuse>0.25 0.25 0.25 0.6</diffuse></material>
      </visual>
      <visual name="rotor_disc_rl">
        <pose>-0.95 0.95 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.4</radius><length>0.015</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 0.6</ambient><diffuse>0.25 0.25 0.25 0.6</diffuse></material>
      </visual>
      <visual name="rotor_disc_rr">
        <pose>-0.95 -0.95 0.1 0 0 0</pose>
        <geometry><cylinder><radius>0.4</radius><length>0.015</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.25 0.6</ambient><diffuse>0.25 0.25 0.25 0.6</diffuse></material>
      </visual>
    </link>
    <joint name="hull_mount" type="fixed">
      <parent>drone::iris_with_standoffs::base_link</parent>
      <child>hull_link</child>
    </joint>

    <!-- 20 L-class spray tank -->
    <link name="tank_link">
      <pose degrees="true">0 0 -0.28 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tank">
        <geometry><cylinder><radius>0.26</radius><length>0.38</length></cylinder></geometry>
        <material>
          <ambient>0.9 0.9 0.95 1</ambient>
          <diffuse>0.9 0.9 0.95 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
    </link>
    <joint name="tank_mount" type="fixed">
      <parent>drone::iris_with_standoffs::base_link</parent>
      <child>tank_link</child>
    </joint>

    <!-- 2.4 m spray boom, 6 nozzles, wide plumes (~5 m swath) -->
    <link name="boom_link">
      <pose degrees="true">0 0 -0.52 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="boom">
        <geometry><box><size>0.05 2.4 0.05</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="nozzle_0">
        <pose>0 -1.15 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_1">
        <pose>0 -0.7 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_2">
        <pose>0 -0.25 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_3">
        <pose>0 0.25 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_4">
        <pose>0 0.7 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_5">
        <pose>0 1.15 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <particle_emitter name="spray_left" type="box">
        <pose degrees="true">0 -0.6 -0.1 0 90 0</pose>
        <emitting>false</emitting>
        <size>0.1 1.2 0.1</size>
        <particle_size>0.12 0.12 0.12</particle_size>
        <lifetime>2.0</lifetime>
        <rate>250</rate>
        <min_velocity>2.5</min_velocity>
        <max_velocity>4.0</max_velocity>
        <scale_rate>2.0</scale_rate>
        <topic>/sprayer/2/spray_cmd</topic>
        <material>
          <diffuse>0.9 0.95 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </particle_emitter>
      <particle_emitter name="spray_right" type="box">
        <pose degrees="true">0 0.6 -0.1 0 90 0</pose>
        <emitting>false</emitting>
        <size>0.1 1.2 0.1</size>
        <particle_size>0.12 0.12 0.12</particle_size>
        <lifetime>2.0</lifetime>
        <rate>250</rate>
        <min_velocity>2.5</min_velocity>
        <max_velocity>4.0</max_velocity>
        <scale_rate>2.0</scale_rate>
        <topic>/sprayer/2/spray_cmd</topic>
        <material>
          <diffuse>0.9 0.95 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </particle_emitter>
    </link>
    <joint name="boom_mount" type="fixed">
      <parent>drone::iris_with_standoffs::base_link</parent>
      <child>boom_link</child>
    </joint>
  </model>
</sdf>
