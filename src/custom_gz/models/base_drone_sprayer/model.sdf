<?xml version='1.0'?>
<sdf version="1.9">
  <!-- Spraying-drone extension of base_drone_3 (instance 3, FDM port 9032):
       wraps the plain drone model (iris_with_gimbal pattern) and adds a spray
       tank, a 4-nozzle boom, and downward particle-emitter spray plumes.

       Sized to a DJI Agras T25-class platform (20 L tank, 16 L/min max flow,
       ~5 m swath). The matching ArduPilot AC_Sprayer configuration lives in
       src/swarm_control/parameters/sprayer.parm (applied when the container
       boots with DRONE_ROLE=sprayer).

       The plumes are OFF by default. Toggle at runtime (host side):
         gz topic -t /sprayer/spray_cmd -m gz.msgs.ParticleEmitter \
           -p 'emitting: {data: true}'
       The world must load gz::sim::systems::ParticleEmitter for the plumes
       to render (see swarm_drone_spray.sdf). -->
  <model name="drone4_sprayer">
    <include>
      <uri>model://base_drone_3</uri>
      <name>drone</name>
    </include>

    <!-- Spray tank slung under the airframe -->
    <link name="tank_link">
      <pose degrees="true">0 0 -0.12 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tank">
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.9 1</ambient>
          <diffuse>0.85 0.85 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
    <joint name="tank_mount" type="fixed">
      <parent>drone::iris_with_standoffs::base_link</parent>
      <child>tank_link</child>
    </joint>

    <!-- Spray boom with 4 nozzles and particle-emitter plumes.
         Emitters fire along their +x axis; pitch +90° points them straight
         down. Velocity/lifetime give a ~1.5 m visible plume; the boom span
         plus spread approximates a ~5 m swath at survey altitude. -->
    <link name="boom_link">
      <pose degrees="true">0 0 -0.22 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="boom">
        <geometry>
          <box>
            <size>0.02 0.7 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="nozzle_left_outer">
        <pose>0 -0.33 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_left_inner">
        <pose>0 -0.11 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_right_inner">
        <pose>0 0.11 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
      <visual name="nozzle_right_outer">
        <pose>0 0.33 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>

      <particle_emitter name="spray_left" type="box">
        <pose degrees="true">0 -0.22 -0.06 0 90 0</pose>
        <emitting>false</emitting>
        <size>0.05 0.45 0.05</size>
        <particle_size>0.06 0.06 0.06</particle_size>
        <lifetime>1.5</lifetime>
        <rate>150</rate>
        <min_velocity>1.5</min_velocity>
        <max_velocity>2.5</max_velocity>
        <scale_rate>1.5</scale_rate>
        <topic>/sprayer/spray_cmd</topic>
        <material>
          <diffuse>0.9 0.95 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </particle_emitter>
      <particle_emitter name="spray_right" type="box">
        <pose degrees="true">0 0.22 -0.06 0 90 0</pose>
        <emitting>false</emitting>
        <size>0.05 0.45 0.05</size>
        <particle_size>0.06 0.06 0.06</particle_size>
        <lifetime>1.5</lifetime>
        <rate>150</rate>
        <min_velocity>1.5</min_velocity>
        <max_velocity>2.5</max_velocity>
        <scale_rate>1.5</scale_rate>
        <topic>/sprayer/spray_cmd</topic>
        <material>
          <diffuse>0.9 0.95 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
        </material>
      </particle_emitter>
    </link>
    <joint name="boom_mount" type="fixed">
      <parent>drone::iris_with_standoffs::base_link</parent>
      <child>boom_link</child>
    </joint>
  </model>
</sdf>
