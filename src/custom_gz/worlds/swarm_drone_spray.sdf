    </model>

    <!-- Field 7: Cotton (0, 100) -->
    <model name="field_7">
      <static>true</static>
      <pose>0 100 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
