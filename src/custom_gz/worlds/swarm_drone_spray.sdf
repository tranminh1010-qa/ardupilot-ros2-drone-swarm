            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://farm_textures/textures/sunflower.png</albedo_map>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Field 9: Alfalfa (100, 100) -->
    <model name="field_9">
      <static>true</static>
      <pose>100 100 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://farm_textures/textures/alfalfa.png</albedo_map>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simulated weeds: oversized magenta blobs over the surveyed area,
         generated by src/custom_gz/worlds/generate_weeds.py (ground truth in
         models/weed_field/ground_truth.json). Detection targets for the
         camera pipeline's HSV weed detector. -->
    <include>
      <uri>model://weed_field</uri>
      <name>weed_field</name>
      <!-- Shift the generator's (45,50)-centred layout onto the surveyed
           square: world (0,0) = field GPS origin under the JSON FDM, so this
           pose makes the visuals coincide with ground_truth.json lat/lons. -->
      <pose>-45 -50 0 0 0 0</pose>
    </include>

    <!-- Drone positions in the center of the world.
         Each drone uses a dedicated model variant with its FDM port baked in
         (fdm_port_in = 9002 + 10*instance), because per-include plugin/port
         overrides are not supported by SDF <include>. -->
    <!-- Drone 1 : instance 0, FDM 9002 -->
    <include>
      <uri>model://base_drone_cam</uri>
      <name>drone1</name>
      <pose degrees="true">45 50 0.2 0 0 0</pose>
    </include>

    <!-- Drone 2 : instance 1, FDM 9012 -->
    <include>
      <uri>model://base_drone_cam_1</uri>
      <name>drone2</name>
      <pose degrees="true">50 50 0.2 0 0 0</pose>
    </include>

    <!-- Drone 3 : instance 2, FDM 9022 -->
    <include>
      <uri>model://base_drone_cam_2</uri>
      <name>drone3</name>
      <pose degrees="true">55 50 0.2 0 0 0</pose>
    </include>

    <!-- Drone 4 : instance 3, FDM 9032 — SPRAYER (AC_Sprayer enabled via
         DRONE_ROLE=sprayer / sprayer.parm; spray plume on /sprayer/3/spray_cmd) -->
    <include>
      <uri>model://base_drone_sprayer_3</uri>
      <name>drone4</name>
      <pose degrees="true">60 50 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>