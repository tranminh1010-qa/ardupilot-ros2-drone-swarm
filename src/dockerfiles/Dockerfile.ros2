# Simplified Dockerfile.ros2 - ROS2 setup with DDS support
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    ROS_DISTRO=humble \
    ROS_DOMAIN_ID=1 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    curl gnupg lsb-release \
    python3 python3-pip \
    git cmake build-essential \
    wget software-properties-common \
    net-tools netcat-openbsd \
    bc vim nano \
    && rm -rf /var/lib/apt/lists/*

# Add ROS 2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS 2 packages
RUN apt-get update && apt-get install -y \
    ros-humble-ros-core \
    ros-humble-ros-base \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-nav-msgs \
    ros-humble-rmw-cyclonedds-cpp \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-argcomplete \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Fix NumPy compatibility issue and install Python packages
RUN pip3 install --no-cache-dir \
    "numpy<2.0" \
    pymavlink dronekit \
    geopy scipy transforms3d \
    matplotlib pandas \
    setuptools wheel

# Initialize rosdep
RUN rosdep init && rosdep update

# Create workspace directories
WORKDIR /root
RUN mkdir -p /root/ros2_ws/src /root/scripts /root/logs /root/config

# Setup ROS environment
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=\${ROS_DOMAIN_ID:-1}" >> ~/.bashrc && \
    echo "export RMW_IMPLEMENTATION=\${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}" >> ~/.bashrc && \
    echo "if [ -f /root/ros2_ws/install/setup.bash ]; then" >> ~/.bashrc && \
    echo "    source /root/ros2_ws/install/setup.bash" >> ~/.bashrc && \
    echo "fi" >> ~/.bashrc

# Create simple info script
RUN cat > /root/scripts/info.sh << 'EOF' && \
echo "=== ROS2 DDS Container Ready ===" && \
echo "ROS_DISTRO: $ROS_DISTRO" && \
echo "ROS_DOMAIN_ID: $ROS_DOMAIN_ID" && \
echo "RMW_IMPLEMENTATION: $RMW_IMPLEMENTATION" && \
echo "" && \
echo "Usage:" && \
echo "  ros2 topic list    - List available topics" && \
echo "  ros2 node list     - List running nodes" && \
echo "  colcon build       - Build workspace" && \
echo "" && \
echo "Swarm control ready!" \
EOF \
    chmod +x /root/scripts/info.sh

# Default command
CMD ["/root/scripts/info.sh"]