# Dockerfile.ros2 - ROS2 setup with MAVROS and DDS support
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    ROS_DISTRO=humble
# Install basic dependencies
RUN apt-get update && apt-get install -y \
    curl gnupg lsb-release \
    python3 python3-pip \
    git cmake build-essential \
    wget software-properties-common \
    net-tools netcat-openbsd \
    bc vim nano \
    && rm -rf /var/lib/apt/lists/*

# Add ROS 2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS 2 core packages
RUN apt-get update && apt-get install -y \
    ros-humble-ros-core \
    ros-humble-ros-base \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-nav-msgs \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rmw-fastrtps-cpp \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*

# Install MAVROS and related packages
RUN apt-get update && apt-get install -y \
    ros-humble-mavros \
    ros-humble-mavros-msgs \
    ros-humble-mavros-extras \
    ros-humble-geographic-msgs \
    ros-humble-geographic-info \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install GeographicLib datasets (needed for MAVROS GPS conversions)
RUN wget https://raw.githubusercontent.com/mavlink/mavros/ros2/mavros/scripts/install_geographiclib_datasets.sh -O /tmp/install_geographiclib_datasets.sh && \
    chmod +x /tmp/install_geographiclib_datasets.sh && \
    /tmp/install_geographiclib_datasets.sh && \
    rm /tmp/install_geographiclib_datasets.sh

# Fix NumPy compatibility issue and install Python packages
RUN pip3 install --no-cache-dir \
    "numpy<2.0" \
    pymavlink dronekit \
    geopy scipy transforms3d \
    matplotlib pandas \
    setuptools wheel

# Initialize rosdep
RUN rosdep init && rosdep update


# Create workspace directories
WORKDIR /root
RUN mkdir -p /root/ros2_ws/src /root/scripts /root/logs /root/config

# Setup ROS environment
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "if [ -f /root/ros2_ws/install/setup.bash ]; then" >> ~/.bashrc && \
    echo "    source /root/ros2_ws/install/setup.bash" >> ~/.bashrc && \
    echo "fi" >> ~/.bashrc

RUN apt-get update && apt-get install -y \
    tini \
    && rm -rf /var/lib/apt/lists/*
# Expose necessary ports
EXPOSE 2019-2030/udp 5501-5591 5760-5780 14550-14750/udp 9001-9052/udp
