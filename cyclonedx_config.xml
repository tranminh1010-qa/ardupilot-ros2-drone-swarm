<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDX xmlns="https://cdn.eclipse.org/cyclonedx" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Domain id="0">
        <General>
            <!-- Disable multicast discovery and use static peers -->
            <EnableMulticastLoopback>false</EnableMulticastLoopback>
            <MaxAutoParticipantIndex>100</MaxAutoParticipantIndex>
        </General>

        <Discovery>
            <!-- Use static peer discovery instead of multicast -->
            <ParticipantIndex>auto</ParticipantIndex>
            <SPDPMulticastAddress>none</SPDPMulticastAddress>
            <SPDPInterval>100ms</SPDPInterval>

            <!-- Define static peer addresses for container network -->
            <Peers>
                <!-- ArduPilot SITL container -->
                <Peer address="172.20.0.10" port="7410"/>
                <!-- Micro-ROS Agent container -->
                <Peer address="172.20.0.20" port="7410"/>
                <!-- Swarm Controller container -->
                <Peer address="172.20.0.30" port="7410"/>
                <!-- Add localhost for host processes -->
                <Peer address="127.0.0.1" port="7410"/>
            </Peers>
        </Discovery>

        <Internal>
            <!-- Configure buffer sizes for container networking -->
            <SocketReceiveBufferSize min="1MB"/>
            <SocketSendBufferSize>1MB</SocketSendBufferSize>
            <HeartbeatResponseDelay>0ms</HeartbeatResponseDelay>
        </Internal>

        <Tracing>
            <!-- Enable for debugging DDS communication -->
            <Category>discovery</Category>
            <Category>traffic</Category>
            <OutputFile>/tmp/cyclonedx.log</OutputFile>
        </Tracing>
    </Domain>
</CycloneDX>