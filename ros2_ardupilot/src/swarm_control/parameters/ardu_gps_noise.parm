# DDS UDP Param
DDS_ENABLE 1
DDS_UDP_PORT 2019

# Arming and safety
ARMING_CHECK 0
EK3_ENABLE 1
AFS_ENABLE 0
BRD_SAFETY_DEFLT 0

# Set RC failsafe to enable GUIDED mode
FS_THR_ENABLE = 1
FS_THR_VALUE = 910
FS_OPTIONS = 1

# GPS configuration
GPS_TYPE 1
GPS_AUTO_CONFIG 1

# RC configuration
RC_OPTIONS 32

# Frame configuration
FRAME_CLASS 1
FRAME_TYPE 1

# SITL-specific settings
SITL_GPS_TYPE 1
SITL_GPS_NOISE 0
SITL_MAG_ERROR 0

# GPS noise parameters
SIM_GPS_POSNOISE 0.5
SIM_GPS_VELNOISE 0.1
SIM_GPS_HGTNOISE 0.2