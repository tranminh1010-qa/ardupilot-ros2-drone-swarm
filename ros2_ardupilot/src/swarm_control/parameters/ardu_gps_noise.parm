# DDS UDP Param
DDS_ENABLE 1
DDS_UDP_PORT 2019

# Arming and safety
ARMING_CHECK 0  # Disable all pre-arm checks for debugging
EK2_ENABLE 1
EK3_ENABLE 0
EK2_IMU_MASK 3
EK2_CHECK_SCALE 200
GPS_TYPE 14  # SITL
EK2_GPS_TYPE 3  # GPS with SBAS and Baro
AFS_ENABLE 0
BRD_SAFETY_DEFLT 0

# Set RC failsafe to enable GUIDED mode
FS_THR_ENABLE 1
FS_THR_VALUE 910
FS_OPTIONS 1

# GPS noise parameters
SIM_GPS_NOISE 0.2
SIM_GPS_GLITCH_X 1
SIM_GPS_GLITCH_Y 1
SIM_GPS_GLITCH_Z 1

# AHRS and EKF configuration
AHRS_EKF_TYPE 2
EK2_ALT_SOURCE 1
EK2_ACC_NOISE 0.3
EK2_GYRO_NOISE 0.02
EK2_ALT_M_NSE 1.0
EK2_GPS_DELAY_MS 100
EK2_MAG_CAL 5
EK2_MAG_NOISE 0.03

# GPS Configuration
GPS_AUTO_CONFIG 1
GPS_AUTO_SWITCH 1

# Barometer Configuration
BARO1_GND_PRESS 0
BARO_ALT_OFFSET 0

# SITL-specific parameters
SITL_GPS_TYPE 1
SIM_GPS_DISABLE 0
SITL_MAG_FAIL 0
PILOT_THR_FILT 2
INS_GYR_CAL 0

# Additional parameters
SCHED_LOOP_RATE 300
AHRS_GPS_USE 1
AHRS_GPS_MINSATS 6

# EKF parameters for more permissive position estimate
EK2_GPS_CHECK 0
EK2_POS_I_GATE 1000
EK2_GLITCH_RAD 100
EK2_ALT_SOURCE 0

# SITL-specific GPS parameters
SIM_GPS_TYPE 1
SIM_GPS_DELAY 1
SIM_GPS_LOCKTIME 0
SIM_GPS_ALT_OFFSET 0

# Enable compass (magnetometer) for better orientation estimates
COMPASS_ENABLE 1